{
  "name": "nanorod",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  "mounts": [
    {
      "source": "${localWorkspaceFolder}",
      "target": "/workspace",
      "type": "bind"
    },
    {
      "source": "nanorod-cargo-registry",
      "target": "/usr/local/cargo/registry",
      "type": "volume"
    },
    {
      "source": "nanorod-cargo-git",
      "target": "/usr/local/cargo/git",
      "type": "volume"
    },
    {
      "source": "nanorod-target",
      "target": "${containerWorkspaceFolder}/target",
      "type": "volume"
    },
    {
      "source": "${env:SSH_AUTH_SOCK}",
      "target": "/ssh-agent",
      "type": "bind"
    }
  ],
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "configureZshAsDefaultShell": "true",
      "username": "tutu"
    },
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.96.0"
    },
    "ghcr.io/devcontainers/features/nvidia-cuda:3": {
      "installCudnn": true,
      "installToolkit": true,
      "installCudnnDev": true,
      "cudaVersion": "12.2"
    },
    "ghcr.io/devcontainers-extra/features/apt-packages:1": {
      "packages": "build-essential, clang, mold, ripgrep, fd-find, pkg-config, libssl-dev"
    }
  },
  "runArgs": ["--device=nvidia.com/gpu=all"],
  "containerUser": "tutu",
  "postCreateCommand": {
    "fetch-deps": "cargo fetch",
    "install-ax": "curl -fsSL https://ax.yusuke.run/install | sudo env AX_INSTALL_DIR=/usr/bin sh",
    "install-ast-grep": "command -v ast-grep >/dev/null || cargo install ast-grep --locked",
    "install-sem": "command -v sem >/dev/null || cargo install --git https://github.com/Ataraxy-Labs/sem sem-cli"
  },
  "containerEnv": {
    "CARGO_TERM_COLOR": "always",
    "SSH_AUTH_SOCK": "/ssh-agent"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "NVIDIA.nsight-vscode-edition",
        "anthropic.claude-code",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.persistentSessionReviveProcess": "never"
      }
    }
  }
}